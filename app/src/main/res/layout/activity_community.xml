<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/featureRoot"
    android:background="#F3F8F6"
    tools:context=".CommunityActivity">
    <LinearLayout
        android:id="@+id/featureToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#123B36"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnFeatureBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/screen_back"
            app:srcCompat="@drawable/ic_lumia_back" />
        <TextView
            style="@style/Widget.Lumia.FeatureHeading"
            android:text="@string/home_community"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/featureScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_feature_card"
                android:padding="16dp"
                android:layout_marginTop="0dp"
                android:minHeight="190dp">
                <TextView
                    style="@style/Widget.Lumia.FeatureHeading"
                    android:text="@string/community_report_one" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />
                <TextView
                    style="@style/Widget.Lumia.FeatureText"
                    android:text="@string/community_place_one" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
                <TextView
                    style="@style/Widget.Lumia.FeatureCaption"
                    android:text="@string/community_sample" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_feature_card"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:minHeight="190dp">
                <TextView
                    style="@style/Widget.Lumia.FeatureHeading"
                    android:text="@string/community_report_two" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />
                <TextView
                    style="@style/Widget.Lumia.FeatureText"
                    android:text="@string/community_place_two" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
                <TextView
                    style="@style/Widget.Lumia.FeatureCaption"
                    android:text="@string/community_sample" />
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="88dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSendReport"
                style="@style/Widget.Lumia.FeatureAction"
                android:text="@string/community_send" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
