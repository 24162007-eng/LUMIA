<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/featureRoot"
    android:background="#F3F8F6"
    tools:context=".NavigationActivity">
    <LinearLayout
        android:id="@+id/featureToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#123B36"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnFeatureBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/screen_back"
            app:srcCompat="@drawable/ic_lumia_back" />
        <TextView
            style="@style/Widget.Lumia.FeatureHeading"
            android:text="@string/home_go"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/featureScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_feature_outline"
                android:gravity="center_vertical"
                android:paddingEnd="4dp">
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/destinationInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp"
                    android:hint="@string/go_destination"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="#123B36"
                    android:textColorHint="#435D59"
                    android:textSize="16sp" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnDestinationVoice"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/go_destination_voice"
                    app:srcCompat="@drawable/ic_lumia_mic" />
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />
            <TextView
                style="@style/Widget.Lumia.FeatureText"
                android:text="@string/go_map_preview"
                android:gravity="center"
                android:textAlignment="center"
                android:layout_height="240dp"
                android:background="@drawable/bg_feature_map" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_feature_card"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:minHeight="92dp"
                android:gravity="center">
                <TextView
                    style="@style/Widget.Lumia.FeatureHeading"
                    android:text="@string/go_instruction_sample"
                    android:gravity="center"
                    android:textAlignment="center" />
                <TextView
                    style="@style/Widget.Lumia.FeatureCaption"
                    android:text="@string/go_distance_sample"
                    android:gravity="center"
                    android:textAlignment="center" />
            </LinearLayout>
            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCurrentLocation"
                style="@style/Widget.Lumia.FeatureAction"
                android:text="@string/go_current_location" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRepeatDirections"
                style="@style/Widget.Lumia.FeatureOutline"
                android:text="@string/go_repeat" />
            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopNavigation"
                style="@style/Widget.Lumia.FeatureDanger"
                android:text="@string/go_stop" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
