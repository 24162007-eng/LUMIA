<resources>
    <style name="Widget.Lumia.FeatureText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#123B36</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Lumia.FeatureHeading" parent="Widget.Lumia.FeatureText">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Lumia.FeatureCaption" parent="Widget.Lumia.FeatureText">
        <item name="android:textColor">#435D59</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Lumia.FeatureAction" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#123B36</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">#38CDA5</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.Lumia.FeatureOutline" parent="Widget.Lumia.FeatureAction">
        <item name="backgroundTint">#F3F8F6</item>
        <item name="strokeColor">#123B36</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Lumia.FeatureDanger" parent="Widget.Lumia.FeatureAction">
        <item name="backgroundTint">#AC362D</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>
